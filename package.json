{
  "name": "cleo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cleo - Autonomous digital brain for aman",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build",
    "build:mem0": "pnpm --filter @cleo/mem0-mcp-server build",
    "dev:mem0": "pnpm --filter @cleo/mem0-mcp-server dev",
    "docker:build:mem0": "docker build -f packages/mem0-mcp-server/Dockerfile -t cleo/mem0-mcp .",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
