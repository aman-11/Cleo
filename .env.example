# PostgreSQL Configuration (now for structured data only, not vectors)
# This password is used for BOTH the postgres superuser AND mem0user
# The postgres-init.sql script creates mem0user with the same password
# For production, consider using separate passwords (update postgres-init.sql)
POSTGRES_PASSWORD=your_secure_password_here

# mem0 Configuration
# Optional: If set, all mem0 API requests require X-API-Key header
# If not set, mem0 API allows unauthenticated (secure via SSH tunnel + localhost-only)
MEM0_API_KEY=your_mem0_api_key_here

#######################################
# AI Models - 100% FREE Configuration
#######################################

# OpenRouter (FREE tier - no credit card needed)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hugging Face (FREE Inference API)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#######################################
# mem0 Configuration (FREE models)
#######################################

# LLM Model (must end in :free)
# Options:
#   - openrouter/google/gemini-2.0-flash-exp:free (1M context, fast) [RECOMMENDED]
#   - openrouter/qwen/qwen3-coder:free (480B, best for code)
#   - openrouter/deepseek/deepseek-r1-0528:free (strong reasoning)
#   - openrouter/meta-llama/llama-3.3-70b-instruct:free (GPT-4 level)
MEM0_LLM_MODEL=openrouter/google/gemini-2.0-flash-exp:free

# Embedding Model (FREE Hugging Face)
# Options:
#   - sentence-transformers/all-MiniLM-L6-v2 (384 dims, fast) [RECOMMENDED]
#   - sentence-transformers/all-mpnet-base-v2 (768 dims, better quality)
#   - BAAI/bge-small-en-v1.5 (384 dims, multilingual)
MEM0_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

#######################################
# Qdrant Configuration (Phase 1.5 - PRIMARY vector store)
#######################################

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=cleo_memories

#######################################
# Cost Verification
#######################################

# Monthly cost: $0 (OpenRouter free tier + HF Inference API)
# Rate limits:
#   - OpenRouter: 50 req/day (no credits) or 1000 req/day (after $10 one-time)
#   - Hugging Face: ~few hundred req/hour
# Quality: Production-ready, matches/exceeds paid alternatives

# Discord Bot (for OpenClaw configuration)
# Configure via OpenClaw CLI after deployment:
#   cd /home/aman/openclaw
#   docker compose run --rm openclaw-cli channels add --channel discord --token "YOUR_TOKEN"
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here
WATCHED_USERNAME=your_watched_username_here

# GitHub (for future phases)
GITHUB_TOKEN=your_github_pat_here

# Heartbeat Configuration
HEARTBEAT_CRON=*/30 * * * *  # Every 30 minutes

# Internal URLs (don't change unless you know what you're doing)
MEM0_API_URL=http://mem0:8080
OPENCLAW_API_URL=http://openclaw:18789

# ===== VPS ACCESS INSTRUCTIONS =====
# All services run on VPS at 89.167.74.98, bound to localhost (127.0.0.1)
# Access via SSH tunnel from local machine:
#
# mem0 API:
#   ssh -L 8080:localhost:8080 cleo-vps
#   curl http://localhost:8080/health
#
# OpenClaw Dashboard:
#   ssh -L 18789:localhost:18789 cleo-vps
#   Browse to http://localhost:18789
