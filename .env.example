# PostgreSQL
POSTGRES_PASSWORD=your_secure_password_here

# mem0 Configuration
MEM0_API_KEY=your_mem0_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Required for mem0 embeddings

# Discord Bot (for OpenClaw configuration)
# Configure via OpenClaw CLI after deployment:
#   cd /home/aman/openclaw
#   docker compose run --rm openclaw-cli channels add --channel discord --token "YOUR_TOKEN"
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here
WATCHED_USERNAME=your_watched_username_here

# GitHub (for future phases)
GITHUB_TOKEN=your_github_pat_here

# OpenRouter (for future phases - PR review)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Heartbeat Configuration
HEARTBEAT_CRON=*/30 * * * *  # Every 30 minutes

# Internal URLs (don't change unless you know what you're doing)
MEM0_API_URL=http://mem0:8080
OPENCLAW_API_URL=http://openclaw:18789

# ===== VPS ACCESS INSTRUCTIONS =====
# All services run on VPS at 89.167.74.98, bound to localhost (127.0.0.1)
# Access via SSH tunnel from local machine:
#
# mem0 API:
#   ssh -L 8080:localhost:8080 cleo-vps
#   curl http://localhost:8080/health
#
# OpenClaw Dashboard:
#   ssh -L 18789:localhost:18789 cleo-vps
#   Browse to http://localhost:18789
