{
  "$schema": "https://safeclaw.io/schemas/openclaw-config.json",
  "version": "1.0.0",
  "agents": {
    "list": [
      {
        "id": "cleo",
        "name": "Cleo",
        "description": "Autonomous digital brain for aman",
        "system_prompt": "You are Cleo, aman's autonomous digital brain. You monitor GitHub, review PRs, and assist aman with tasks. You have access to mem0 for long-term memory.",
        "mcp": {
          "servers": [
            {
              "name": "mem0",
              "description": "Long-term memory storage and retrieval via mem0",
              "command": "docker",
              "args": [
                "exec",
                "-i",
                "cleo-mem0-mcp",
                "node",
                "dist/index.js"
              ],
              "env": {
                "MEM0_API_URL": "http://mem0:8080",
                "MEM0_API_KEY": "${MEM0_API_KEY}"
              },
              "tools": [
                "add_memory",
                "search_memories",
                "get_all_memories",
                "update_memory",
                "delete_memory"
              ]
            }
          ]
        }
      }
    ],
    "default": "cleo"
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18789,
    "cors": {
      "enabled": false
    },
    "discord": {
      "enabled": true,
      "token": "${DISCORD_TOKEN}",
      "dm_only": true,
      "user_id": "${DISCORD_USER_ID}"
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  }
}
