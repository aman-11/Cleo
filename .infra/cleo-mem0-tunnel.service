# /etc/systemd/user/cleo-mem0-tunnel.service
#
# DEPRECATED: This service will be obsolete after Tailscale setup (Plan 01.5-06).
# Tailscale runs as a system service with auto-reconnect, replacing this SSH tunnel.
#
# Optional: Run the SSH tunnel as a user systemd service for always-on access.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp .infra/cleo-mem0-tunnel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable cleo-mem0-tunnel
#   systemctl --user start cleo-mem0-tunnel
#
# Check status:
#   systemctl --user status cleo-mem0-tunnel

[Unit]
Description=SSH Tunnel to Cleo VPS mem0 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'autossh -M 0 -N -L 9090:localhost:8080 -o "ServerAliveInterval=30" -o "ServerAliveCountMax=3" -o "ExitOnForwardFailure=yes" aman@cleo-vps'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
